# embed_glsl_sources.cmake - compile GLSL include files into the library.
#
# Run in script mode:
#   cmake -DGLSL_FILES=... -DOUTPUT_SOURCE=... -DOUTPUT_HEADER=...
#         -P embed_glsl_sources.cmake
#
# The Vulkan operator JIT compiles GLSL at runtime and #includes the shared
# kernel helpers. Embedding them (keyed by file name) keeps the JIT working
# from an installed wheel or toolbox, where the source tree does not exist.

if(NOT DEFINED GLSL_FILES)
  message(FATAL_ERROR "GLSL_FILES is required.")
endif()
if(NOT DEFINED OUTPUT_SOURCE OR NOT DEFINED OUTPUT_HEADER)
  message(FATAL_ERROR "OUTPUT_SOURCE and OUTPUT_HEADER are required.")
endif()

set(header_body
"/* Generated by cmake/embed_glsl_sources.cmake -- do not edit. */
#ifndef NLO_VK_JIT_GLSL_SOURCES_H
#define NLO_VK_JIT_GLSL_SOURCES_H

#include <stddef.h>

/** A GLSL include file compiled into the library. */
typedef struct {
    const char* name;   /**< File name as written in #include. */
    const char* text;   /**< File contents, NUL-terminated. */
    size_t length;      /**< Length in bytes, without the terminator. */
} vk_jit_glsl_source;

extern const vk_jit_glsl_source vk_jit_glsl_sources[];
extern const size_t vk_jit_glsl_source_count;

#endif /* NLO_VK_JIT_GLSL_SOURCES_H */
")

set(arrays "")
set(entries "")
set(index 0)
foreach(glsl_file IN LISTS GLSL_FILES)
  if(NOT EXISTS "${glsl_file}")
    message(FATAL_ERROR "GLSL include not found: ${glsl_file}")
  endif()
  get_filename_component(glsl_name "${glsl_file}" NAME)
  file(READ "${glsl_file}" glsl_hex HEX)
  string(LENGTH "${glsl_hex}" hex_length)
  math(EXPR byte_count "${hex_length} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," glsl_bytes "${glsl_hex}")
  # Wrap long lines, 16 bytes each (CMake regex has no {n} repeat).
  string(REPEAT "0x[0-9a-f][0-9a-f]," 16 line_re)
  string(REGEX REPLACE "(${line_re})" "\\1\n    " glsl_bytes "${glsl_bytes}")
  string(APPEND arrays
"static const char glsl_source_${index}[] = {
    ${glsl_bytes} 0x00
};

")
  string(APPEND entries "    {\"${glsl_name}\", glsl_source_${index}, ${byte_count}u},\n")
  math(EXPR index "${index} + 1")
endforeach()

set(source_body
"/* Generated by cmake/embed_glsl_sources.cmake -- do not edit. */
#include \"vk_jit_glsl_sources.h\"

${arrays}const vk_jit_glsl_source vk_jit_glsl_sources[] = {
${entries}};

const size_t vk_jit_glsl_source_count = ${index}u;
")

# Only rewrite when the contents change, so downstream compilation is not
# invalidated on every build.
foreach(pair "OUTPUT_HEADER;header_body" "OUTPUT_SOURCE;source_body")
  list(GET pair 0 out_var)
  list(GET pair 1 body_var)
  set(out_path "${${out_var}}")
  if(EXISTS "${out_path}")
    file(READ "${out_path}" existing)
  else()
    set(existing "")
  endif()
  if(NOT existing STREQUAL "${${body_var}}")
    file(WRITE "${out_path}" "${${body_var}}")
  endif()
endforeach()
