#!/usr/bin/env sh
set -eu

# @HOOK_MARKER@
#
# The project version lives in CMakeLists.txt, and sbom.cdx.json stamps a copy
# of it alongside the dependency pins from cmake/NLODependencies.cmake.
#
# Nothing advances the version by itself. A release bumps it deliberately:
#
#   python tools/release/check_versions.py --bump minor
#
# This hook only enforces that the SBOM agrees with both, so every commit names
# one self-consistent version and a release tag can be cut from any commit. The
# bindings are separate repositories with versions of their own.

python_bin="@HOOK_PYTHON@"
if [ ! -x "$python_bin" ]; then
  python_bin="$(command -v python3 2>/dev/null || command -v python 2>/dev/null || true)"
fi

# A missing interpreter must not block a commit; the same check runs in CTest
# and in the release workflows.
if [ -z "$python_bin" ]; then
  echo "pre-commit: no Python interpreter found; skipping the version check." >&2
  exit 0
fi

if ! "$python_bin" "@HOOK_CHECK_SCRIPT@" --check >/dev/null; then
  echo "pre-commit: sbom.cdx.json is stale; regenerate it with" >&2
  echo "  python tools/release/check_versions.py --write" >&2
  echo "then stage the result." >&2
  exit 1
fi
