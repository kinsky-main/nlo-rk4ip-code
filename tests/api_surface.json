{
  "_comment": [
    "The public surface every nlolib binding (Python, MATLAB, Julia) is expected",
    "to expose: one vocabulary and one structure, each in its language's idiom.",
    "docs/binding_api_vocabulary.md is the prose version of this file.",
    "",
    "tools/check_api_parity.py compares the three binding sources with this",
    "file, text-only. It reports the differences and exits 0 unless run with",
    "--surface enforce. tests/api_parity.json (the integer constants) is the",
    "older, still enforcing check; it goes away once the bindings have dropped",
    "the integer constants.",
    "",
    "Conventions: a default of null means unset. A parameter with kind",
    "'positional' is passed by position; kind 'option' is passed by name",
    "(Python keyword, Julia keyword after ';', MATLAB name=value). 'enum' names",
    "an entry of 'enums': the public value is the lowercase string, and the",
    "binding maps it to the C integer privately."
  ],
  "version": 1,

  "functions": {
    "load": {
      "params": [{"name": "path", "kind": "positional", "default": null}],
      "returns": "nothing; loads the nlolib shared library, from path when given"
    },
    "loaded_library_path": {
      "params": [],
      "returns": "path of the loaded shared library"
    },
    "propagate": {
      "params": [
        {"name": "pulse", "kind": "positional", "required": true, "type": "PulseSpec"},
        {"name": "linear_operator", "kind": "positional", "required": true},
        {"name": "nonlinear_operator", "kind": "positional", "required": true},
        {"name": "propagation_distance", "kind": "option", "required": true},
        {"name": "preset", "kind": "option", "default": "balanced"},
        {"name": "starting_step_size", "kind": "option", "default": null},
        {"name": "max_step_size", "kind": "option", "default": null},
        {"name": "min_step_size", "kind": "option", "default": null},
        {"name": "error_tolerance", "kind": "option", "default": null},
        {"name": "num_records", "kind": "option", "default": null},
        {"name": "record_z", "kind": "option", "default": null},
        {"name": "return_records", "kind": "option", "default": true},
        {"name": "potential_operator", "kind": "option", "default": null},
        {"name": "linear_step_operator", "kind": "option", "default": null},
        {"name": "constant_bindings", "kind": "option", "default": null},
        {"name": "nonlinear_model", "kind": "option", "default": "expr", "enum": "nonlinear_model"},
        {"name": "nonlinear_gamma", "kind": "option", "default": 0.0},
        {"name": "raman_fraction", "kind": "option", "default": 0.0},
        {"name": "raman_tau1", "kind": "option", "default": 0.0122},
        {"name": "raman_tau2", "kind": "option", "default": 0.0320},
        {"name": "shock_omega0", "kind": "option", "default": 0.0},
        {"name": "raman_response_time", "kind": "option", "default": null},
        {"name": "exec_options", "kind": "option", "default": null, "type": "ExecutionOptions"},
        {"name": "storage", "kind": "option", "default": null, "type": "StorageOptions"},
        {"name": "capture_step_history", "kind": "option", "default": false},
        {"name": "step_history_capacity", "kind": "option", "default": 200000},
        {"name": "progress_callback", "kind": "option", "default": null}
      ],
      "returns": "PropagationResult"
    },
    "query_runtime_limits": {
      "params": [
        {"name": "pulse", "kind": "option", "default": null, "type": "PulseSpec"},
        {"name": "exec_options", "kind": "option", "default": null, "type": "ExecutionOptions"}
      ],
      "returns": "RuntimeLimits"
    },
    "storage_is_available": {"params": [], "returns": "boolean"},
    "tensor_record_view": {
      "params": [
        {"name": "record", "kind": "positional", "required": true},
        {"name": "nt", "kind": "positional", "required": true},
        {"name": "nx", "kind": "positional", "required": true},
        {"name": "ny", "kind": "positional", "required": true}
      ],
      "returns": "the one flat record reshaped to (t, y, x), t fastest; Python returns nested lists"
    },
    "set_log_file": {
      "params": [
        {"name": "path", "kind": "positional", "required": true},
        {"name": "append", "kind": "option", "default": false}
      ]
    },
    "set_log_buffer": {
      "params": [{"name": "capacity_bytes", "kind": "positional", "default": 262144}]
    },
    "clear_log_buffer": {"params": []},
    "read_log_buffer": {
      "params": [
        {"name": "consume", "kind": "option", "default": true},
        {"name": "max_bytes", "kind": "option", "default": 262144}
      ],
      "returns": "string"
    },
    "set_log_level": {
      "params": [{"name": "level", "kind": "positional", "default": "info", "enum": "log_level"}]
    },
    "set_progress_options": {
      "params": [
        {"name": "enabled", "kind": "option", "default": true},
        {"name": "milestone_percent", "kind": "option", "default": 5},
        {"name": "emit_on_step_adjust", "kind": "option", "default": false}
      ]
    },
    "set_progress_stream": {
      "params": [{"name": "stream_mode", "kind": "positional", "default": "stderr", "enum": "progress_stream"}]
    },
    "perf_profile_set_enabled": {
      "params": [{"name": "enabled", "kind": "positional", "default": true}]
    },
    "perf_profile_is_enabled": {"params": [], "returns": "boolean"},
    "perf_profile_reset": {"params": []},
    "perf_profile_read": {"params": [], "returns": "PerfProfileSnapshot"}
  },

  "types": {
    "_comment": [
      "Python: dataclasses / exception classes. Julia: structs. MATLAB: plain",
      "structs with these field names (no class), so 'matlab' is null and only",
      "the field words are checked there. Errors are in 'errors'."
    ],
    "PulseSpec": {
      "names": {"python": "PulseSpec", "julia": "PulseSpec", "matlab": null},
      "fields": [
        {"name": "samples", "required": true},
        {"name": "delta_time", "required": true},
        {"name": "pulse_period", "default": null},
        {"name": "frequency_grid", "default": null},
        {"name": "tensor_nt", "default": null},
        {"name": "tensor_nx", "default": null},
        {"name": "tensor_ny", "default": null},
        {"name": "delta_x", "default": 1.0},
        {"name": "delta_y", "default": 1.0},
        {"name": "spatial_frequency_grid", "default": null},
        {"name": "potential_grid", "default": null},
        {"name": "wt_axis", "default": null},
        {"name": "kx_axis", "default": null},
        {"name": "ky_axis", "default": null}
      ]
    },
    "ExecutionOptions": {
      "names": {"python": "ExecutionOptions", "julia": "ExecutionOptions", "matlab": null},
      "fields": [
        {"name": "backend_type", "default": "auto", "enum": "vector_backend"},
        {"name": "fft_backend", "default": "auto", "enum": "fft_backend"},
        {"name": "device_heap_fraction", "default": 0.70},
        {"name": "record_ring_target", "default": 0},
        {"name": "forced_device_budget_bytes", "default": 0}
      ]
    },
    "StorageOptions": {
      "names": {"python": "StorageOptions", "julia": "StorageOptions", "matlab": null},
      "fields": [
        {"name": "sqlite_path", "required": true},
        {"name": "run_id", "default": null},
        {"name": "sqlite_max_bytes", "default": 0},
        {"name": "chunk_records", "default": 0},
        {"name": "cap_policy", "default": "stop_writes", "enum": "storage_cap_policy"},
        {"name": "log_final_output_field_to_db", "default": false}
      ]
    },
    "PropagationResult": {
      "names": {"python": "PropagationResult", "julia": "PropagationResult", "matlab": null},
      "fields": [
        {"name": "records"},
        {"name": "z_axis"},
        {"name": "final"},
        {"name": "step_history"},
        {"name": "storage_result"},
        {"name": "meta"}
      ],
      "notes": [
        "records layout is the language's own: Python list of rows, MATLAB records x samples, Julia samples x records.",
        "step_history is unset unless capture_step_history; storage_result is unset unless storage was given.",
        "meta holds exactly: preset, records_requested, records_written, backend_requested, coupled, status."
      ],
      "meta": [
        {"name": "preset"},
        {"name": "records_requested"},
        {"name": "records_written"},
        {"name": "backend_requested", "enum": "vector_backend"},
        {"name": "coupled"},
        {"name": "status", "enum": "status"}
      ]
    },
    "StepHistory": {
      "names": {"python": "StepHistory", "julia": "StepHistory", "matlab": null},
      "fields": [
        {"name": "step_index"}, {"name": "z"}, {"name": "step_size"},
        {"name": "next_step_size"}, {"name": "error"}, {"name": "dropped"}, {"name": "capacity"}
      ]
    },
    "StorageResult": {
      "names": {"python": "StorageResult", "julia": "StorageResult", "matlab": null},
      "fields": [
        {"name": "run_id"}, {"name": "records_captured"}, {"name": "records_spilled"},
        {"name": "chunks_written"}, {"name": "db_size_bytes"}, {"name": "truncated"}
      ]
    },
    "ProgressInfo": {
      "names": {"python": "ProgressInfo", "julia": "ProgressInfo", "matlab": null},
      "fields": [
        {"name": "event_type", "enum": "progress_event"},
        {"name": "step_index"}, {"name": "reject_attempt"}, {"name": "z"}, {"name": "z_end"},
        {"name": "percent"}, {"name": "step_size"}, {"name": "next_step_size"}, {"name": "error"},
        {"name": "elapsed_seconds"}, {"name": "eta_seconds"}
      ]
    },
    "RuntimeLimits": {
      "names": {"python": "RuntimeLimits", "julia": "RuntimeLimits", "matlab": null},
      "fields": [
        {"name": "max_num_time_samples_runtime"},
        {"name": "max_num_recorded_samples_in_memory"},
        {"name": "max_num_recorded_samples_with_storage"},
        {"name": "estimated_required_working_set_bytes"},
        {"name": "estimated_device_budget_bytes"},
        {"name": "storage_available"}
      ]
    },
    "PerfProfileSnapshot": {
      "names": {"python": "PerfProfileSnapshot", "julia": "PerfProfileSnapshot", "matlab": null},
      "fields": [
        {"name": "dispersion_ms"}, {"name": "nonlinear_ms"},
        {"name": "dispersion_calls"}, {"name": "nonlinear_calls"},
        {"name": "gpu_dispatch_count"}, {"name": "gpu_copy_count"},
        {"name": "gpu_device_copy_count"}, {"name": "gpu_device_copy_bytes"},
        {"name": "gpu_host_transfer_copy_count"}, {"name": "gpu_host_transfer_copy_bytes"},
        {"name": "gpu_memory_pass_count"}, {"name": "gpu_memory_pass_bytes"},
        {"name": "gpu_upload_count"}, {"name": "gpu_download_count"},
        {"name": "gpu_upload_bytes"}, {"name": "gpu_download_bytes"},
        {"name": "operator_jit_programs"}, {"name": "operator_jit_fallbacks"}
      ]
    }
  },

  "enums": {
    "_comment": [
      "Every enum-style value on the public surface is a lowercase string. The",
      "binding maps it to the C integer privately; the integer constants are in",
      "'removed'. An unknown string is the 'bad option value' error. Values",
      "listed under 'direction': 'output' are strings the binding hands back."
    ],
    "vector_backend": {
      "c_type": "vector_backend_type",
      "direction": "input",
      "used_by": ["ExecutionOptions.backend_type", "PropagationResult.meta.backend_requested"],
      "default": "auto",
      "values": {
        "cpu": {"c_name": "VECTOR_BACKEND_CPU", "c_value": 0},
        "vulkan": {"c_name": "VECTOR_BACKEND_VULKAN", "c_value": 1},
        "auto": {"c_name": "VECTOR_BACKEND_AUTO", "c_value": 2}
      }
    },
    "fft_backend": {
      "c_type": "fft_backend_type",
      "direction": "input",
      "used_by": ["ExecutionOptions.fft_backend"],
      "default": "auto",
      "values": {
        "auto": {"c_name": "FFT_BACKEND_AUTO", "c_value": 0},
        "fftw": {"c_name": "FFT_BACKEND_FFTW", "c_value": 1},
        "vkfft": {"c_name": "FFT_BACKEND_VKFFT", "c_value": 2}
      }
    },
    "nonlinear_model": {
      "c_type": "nonlinear_model",
      "direction": "input",
      "used_by": ["propagate.nonlinear_model"],
      "default": "expr",
      "values": {
        "expr": {"c_name": "NONLINEAR_MODEL_EXPR", "c_value": 0},
        "kerr_raman": {"c_name": "NONLINEAR_MODEL_KERR_RAMAN", "c_value": 1}
      }
    },
    "storage_cap_policy": {
      "c_type": "storage_db_cap_policy",
      "direction": "input",
      "used_by": ["StorageOptions.cap_policy"],
      "default": "stop_writes",
      "values": {
        "stop_writes": {"c_name": "STORAGE_DB_CAP_POLICY_STOP_WRITES", "c_value": 0},
        "fail": {"c_name": "STORAGE_DB_CAP_POLICY_FAIL", "c_value": 1}
      }
    },
    "log_level": {
      "c_type": "nlolib_log_level",
      "direction": "input",
      "used_by": ["set_log_level.level"],
      "default": "info",
      "values": {
        "error": {"c_name": "NLOLIB_LOG_LEVEL_ERROR", "c_value": 0},
        "warn": {"c_name": "NLOLIB_LOG_LEVEL_WARN", "c_value": 1},
        "info": {"c_name": "NLOLIB_LOG_LEVEL_INFO", "c_value": 2},
        "debug": {"c_name": "NLOLIB_LOG_LEVEL_DEBUG", "c_value": 3}
      }
    },
    "progress_stream": {
      "c_type": "nlolib_progress_stream_mode",
      "direction": "input",
      "used_by": ["set_progress_stream.stream_mode"],
      "default": "stderr",
      "values": {
        "stderr": {"c_name": "NLOLIB_PROGRESS_STREAM_STDERR", "c_value": 0},
        "stdout": {"c_name": "NLOLIB_PROGRESS_STREAM_STDOUT", "c_value": 1},
        "both": {"c_name": "NLOLIB_PROGRESS_STREAM_BOTH", "c_value": 2}
      }
    },
    "progress_event": {
      "c_type": "progress event_type",
      "direction": "output",
      "used_by": ["ProgressInfo.event_type"],
      "values": {
        "accepted": {"c_name": "PROGRESS_EVENT_ACCEPTED", "c_value": 0},
        "rejected": {"c_name": "PROGRESS_EVENT_REJECTED", "c_value": 1},
        "finish": {"c_name": "PROGRESS_EVENT_FINISH", "c_value": 2}
      }
    },
    "status": {
      "c_type": "nlolib_status",
      "direction": "output",
      "used_by": ["PropagationResult.meta.status", "NlolibError.status"],
      "values": {
        "ok": {"c_name": "NLOLIB_STATUS_OK", "c_value": 0},
        "invalid_argument": {"c_name": "NLOLIB_STATUS_INVALID_ARGUMENT", "c_value": 1},
        "allocation_failed": {"c_name": "NLOLIB_STATUS_ALLOCATION_FAILED", "c_value": 2},
        "not_implemented": {"c_name": "NLOLIB_STATUS_NOT_IMPLEMENTED", "c_value": 3},
        "aborted": {"c_name": "NLOLIB_STATUS_ABORTED", "c_value": 4}
      }
    }
  },

  "presets": {
    "_comment": [
      "Step sizes are propagation_distance divided by the listed divisor. An",
      "explicit option overrides the preset's value."
    ],
    "fast": {
      "starting_step_divisor": 120, "max_step_divisor": 12, "min_step_divisor": 4000,
      "error_tolerance": 5e-6, "num_records": 64
    },
    "balanced": {
      "starting_step_divisor": 200, "max_step_divisor": 25, "min_step_divisor": 20000,
      "error_tolerance": 1e-6, "num_records": 128
    },
    "accuracy": {
      "starting_step_divisor": 400, "max_step_divisor": 50, "min_step_divisor": 80000,
      "error_tolerance": 1e-7, "num_records": 192
    }
  },

  "errors": {
    "_comment": [
      "Same conditions, each language's own type. 'classes' are the public",
      "exception types a binding defines; MATLAB uses the seven ids in",
      "'matlab_ids' (plus its own name=value error) and no other 'nlolib:'",
      "identifier."
    ],
    "classes": {
      "python": {
        "NlolibError": {"base": "RuntimeError", "fields": ["status"]},
        "PropagationAbortedError": {"base": "NlolibError", "fields": ["result"]}
      },
      "julia": {
        "NLOLibError": {"base": "Exception", "fields": ["status", "context"]},
        "PropagationAbortedError": {"base": "Exception", "fields": ["result"]}
      }
    },
    "matlab_ids": [
      "nlolib:invalidOperator",
      "nlolib:invalidPulse",
      "nlolib:invalidOption",
      "nlolib:libraryLoadFailed",
      "nlolib:unavailable",
      "nlolib:statusFailed",
      "nlolib:propagationAborted"
    ],
    "conditions": [
      {"condition": "operator is not a function (strings included)",
       "python": "TypeError", "julia": "ArgumentError", "matlab": "nlolib:invalidOperator"},
      {"condition": "operator body cannot be translated, or uses a symbol its context does not allow",
       "python": "ValueError", "julia": "ArgumentError", "matlab": "nlolib:invalidOperator"},
      {"condition": "bad pulse",
       "python": "ValueError", "julia": "ArgumentError", "matlab": "nlolib:invalidPulse"},
      {"condition": "bad option value (includes an unknown enum string)",
       "python": "ValueError", "julia": "ArgumentError", "matlab": "nlolib:invalidOption"},
      {"condition": "unknown option name",
       "python": "TypeError (native)", "julia": "MethodError (native)", "matlab": "MATLAB's own name=value error"},
      {"condition": "library not found or not loadable",
       "python": "OSError", "julia": "NLOLibError", "matlab": "nlolib:libraryLoadFailed"},
      {"condition": "feature not in this build",
       "python": "NlolibError", "julia": "NLOLibError", "matlab": "nlolib:unavailable"},
      {"condition": "C call returned a non-OK status",
       "python": "NlolibError", "julia": "NLOLibError", "matlab": "nlolib:statusFailed"},
      {"condition": "aborted by progress callback",
       "python": "PropagationAbortedError", "julia": "PropagationAbortedError", "matlab": "nlolib:propagationAborted"}
    ]
  },

  "operator_lowering": {
    "_comment": [
      "Established from src/physics/operator_program_compile.c",
      "(context_allows_symbol_*) and src/core/init_state_builder.c, which",
      "compiles dispersion_factor_expr + dispersion_expr for a temporal run and",
      "linear_factor_expr + linear_expr + potential_expr for a tensor run, and",
      "nothing else. The other slots are ignored for that run type."
    ],
    "run_type": {
      "temporal": "pulse.tensor_nt is unset",
      "tensor": "pulse.tensor_nt, tensor_nx and tensor_ny are set"
    },
    "rule": [
      "The binding picks the C context by run type and writes the lowered text to the one C field the core compiles for that run type; it leaves the other field unset.",
      "A parameter binds by name when its name is a symbol of the context (or an alias of one); otherwise it takes the next unused symbol in the context's parameter order.",
      "A symbol the context does not list is the 'operator cannot be translated' error, raised by the binding before the C call.",
      "w and wt name the same axis in every linear context, so one linear operator written as (A, w) works for both run types.",
      "potential_operator on a temporal run is a bad option value: the core does not compile it there. Use pulse.potential_grid.",
      "potential_operator is ignored by the core when pulse.potential_grid is set; passing both is a bad option value."
    ],
    "slots": {
      "linear_operator": {
        "temporal": {"c_field": "dispersion_factor_expr", "context": "dispersion_factor"},
        "tensor": {"c_field": "linear_factor_expr", "context": "linear_factor"}
      },
      "linear_step_operator": {
        "temporal": {"c_field": "dispersion_expr", "context": "dispersion"},
        "tensor": {"c_field": "linear_expr", "context": "linear"}
      },
      "potential_operator": {
        "temporal": null,
        "tensor": {"c_field": "potential_expr", "context": "potential"}
      },
      "nonlinear_operator": {
        "temporal": {"c_field": "nonlinear_expr", "context": "nonlinear"},
        "tensor": {"c_field": "nonlinear_expr", "context": "nonlinear"}
      }
    },
    "contexts": {
      "dispersion_factor": {
        "c_enum": 0, "run_type": "temporal",
        "parameters": ["A", "w"],
        "aliases": {"wt": "w"},
        "c_allows": ["A", "w", "wt"]
      },
      "dispersion": {
        "c_enum": 1, "run_type": "temporal",
        "parameters": ["A", "D", "h", "w", "V"],
        "aliases": {"wt": "w"},
        "c_allows": ["A", "D", "h", "V", "w", "wt"]
      },
      "linear_factor": {
        "c_enum": 3, "run_type": "tensor",
        "parameters": ["A", "wt", "kx", "ky", "x", "y", "t"],
        "aliases": {"w": "wt"},
        "c_allows": ["A", "wt", "kx", "ky", "x", "y", "t"],
        "c_note": "the C parser also accepts w here and compiles it as wt"
      },
      "linear": {
        "c_enum": 4, "run_type": "tensor",
        "parameters": ["A", "D", "h", "wt", "kx", "ky", "x", "y", "t", "V"],
        "aliases": {"w": "wt"},
        "c_allows": ["A", "D", "h", "V", "wt", "kx", "ky", "x", "y", "t"],
        "c_note": "the C parser also accepts w here and compiles it as wt"
      },
      "potential": {
        "c_enum": 5, "run_type": "tensor",
        "parameters": ["x", "y", "t"],
        "aliases": {},
        "c_allows": ["A", "x", "y", "t"],
        "c_note": "wt, kx and ky are rejected by the C compiler here although all three bindings list them today"
      },
      "nonlinear": {
        "c_enum": 2, "run_type": "both",
        "parameters": ["A", "I", "V"],
        "aliases": {},
        "c_allows": ["A", "I", "V", "x", "y", "t"],
        "c_note": "x, y and t compile in any run but only have grids in a tensor run; the bindings do not expose them"
      }
    },
    "functions": ["exp", "log", "sqrt", "sin", "cos"],
    "imaginary_unit": "i",
    "constants": {"prefix": "c", "max": 16}
  },

  "output_mode_rule": {
    "_comment": "Replaces the 'output' option. The C output mode is private.",
    "rules": [
      "record_z given: dense output at exactly those positions, for any length including one. num_records must be unset or equal to its length, otherwise bad option value.",
      "record_z unset and num_records == 1: final field only; records holds that one field and z_axis is [propagation_distance].",
      "otherwise: dense output at num_records uniformly spaced positions from 0 to propagation_distance (num_records from the preset when unset)."
    ],
    "c_mapping": {
      "record_z": {"output_mode": "PROPAGATE_OUTPUT_DENSE", "c_value": 0, "explicit_record_z": "record_z"},
      "num_records_1": {"output_mode": "PROPAGATE_OUTPUT_FINAL_ONLY", "c_value": 1},
      "uniform": {"output_mode": "PROPAGATE_OUTPUT_DENSE", "c_value": 0}
    }
  },

  "removed": {
    "_comment": [
      "'names' must not be exported (Python __all__, Julia export) nor exist as",
      "a public MATLAB package file. 'words' must not occur anywhere in the",
      "binding's package source: they are option or field spellings with no",
      "private use left. C struct field names (num_recorded_samples,",
      "explicit_record_z, output_mode) are not listed because the private C",
      "layer still uses them."
    ],
    "names": {
      "all": [
        "NLolib", "OperatorSpec", "RuntimeOperators", "PropagateResult",
        "PreparedSimConfig", "prepare_sim_config",
        "default_execution_options", "default_storage_options",
        "NT_MAX", "STORAGE_RUN_ID_MAX", "TENSOR_LAYOUT_XYT_T_FAST",
        "VECTOR_BACKEND_CPU", "VECTOR_BACKEND_VULKAN", "VECTOR_BACKEND_AUTO",
