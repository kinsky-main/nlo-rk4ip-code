#version 460
#extension GL_GOOGLE_include_directive : require
#include "nlo_precision.glslinc"

#include "complex_device.glslinc"

layout(local_size_x = 64) in;

// dst = scalar0*a + scalar1*b [+ scalar2*c [+ scalar3*d]], real coefficients.
// terms (2..4) selects how many sources are read; dst may alias any source.
layout(push_constant) uniform PushConstants {
    uint count;
    uint terms;
    nlo_real scalar0;
    nlo_real scalar1;
    nlo_real scalar2;
    nlo_real scalar3;
} pc;

layout(set = 0, binding = 0, std430) buffer DstBuffer {
    vk_complex64 dst[];
};

layout(set = 0, binding = 1, std430) readonly buffer ABuffer {
    vk_complex64 a[];
};

layout(set = 0, binding = 2, std430) readonly buffer BBuffer {
    vk_complex64 b[];
};

layout(set = 0, binding = 3, std430) readonly buffer CBuffer {
    vk_complex64 c[];
};

layout(set = 0, binding = 4, std430) readonly buffer DBuffer {
    vk_complex64 d[];
};

void main()
{
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.count) {
        return;
    }

    nlo_real re = (pc.scalar0 * a[idx].re) + (pc.scalar1 * b[idx].re);
    nlo_real im = (pc.scalar0 * a[idx].im) + (pc.scalar1 * b[idx].im);
    if (pc.terms >= 3u) {
        re += pc.scalar2 * c[idx].re;
        im += pc.scalar2 * c[idx].im;
    }
    if (pc.terms >= 4u) {
        re += pc.scalar3 * d[idx].re;
        im += pc.scalar3 * d[idx].im;
    }
    dst[idx].re = re;
    dst[idx].im = im;
}
