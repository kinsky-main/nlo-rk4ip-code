#version 460
#extension GL_GOOGLE_include_directive : require
#include "nlo_precision.glslinc"

#include "complex_device.glslinc"

layout(local_size_x = 64) in;

layout(push_constant) uniform PushConstants {
    uint count;
    uint _pad;
    nlo_real scalar0;
    nlo_real scalar1;
} pc;

layout(set = 0, binding = 0, std430) buffer DstBuffer {
    vk_complex64 dst[];
};

layout(set = 0, binding = 1, std430) readonly buffer SrcBuffer {
    vk_complex64 src[];
};

void main()
{
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.count) {
        return;
    }

    uint nt = uint(pc.scalar0);
    uint ny = uint(pc.scalar1);
    if (nt == 0u || ny == 0u) {
        dst[idx].re = 0.0;
        dst[idx].im = 0.0;
        return;
    }

    uint xy = idx / nt;
    uint y = xy % ny;
    dst[idx] = src[y];
}
