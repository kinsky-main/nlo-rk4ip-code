#version 460
#extension GL_GOOGLE_include_directive : require
#include "nlo_precision.glslinc"

#include "complex_device.glslinc"

layout(local_size_x = 64) in;

layout(push_constant) uniform PushConstants {
    uint count;
    uint _pad;
    nlo_real scalar0;
    nlo_real scalar1;
} pc;

layout(set = 0, binding = 0, std430) buffer DstBuffer {
    vk_complex64 dst[];
};

void main()
{
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.count) {
        return;
    }

    nlo_real a_re = dst[idx].re;
    nlo_real a_im = dst[idx].im;
    nlo_real b_re = pc.scalar0;
    nlo_real b_im = pc.scalar1;

    dst[idx].re = a_re * b_re - a_im * b_im;
    dst[idx].im = a_re * b_im + a_im * b_re;
}

