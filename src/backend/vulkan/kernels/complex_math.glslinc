#ifndef COMPLEX_MATH_GLSLINC
#define COMPLEX_MATH_GLSLINC

vk_complex64 jit_make_complex(double re, double im)
{
    vk_complex64 value;
    value.re = re;
    value.im = im;
    return value;
}

double jit_complex_abs_sq(vk_complex64 value)
{
    return (value.re * value.re) + (value.im * value.im);
}

vk_complex64 jit_complex_add(vk_complex64 lhs, vk_complex64 rhs)
{
    return jit_make_complex(lhs.re + rhs.re, lhs.im + rhs.im);
}

vk_complex64 jit_complex_negate(vk_complex64 value)
{
    return jit_make_complex(-value.re, -value.im);
}

vk_complex64 jit_complex_mul(vk_complex64 lhs, vk_complex64 rhs)
{
    return jit_make_complex((lhs.re * rhs.re) - (lhs.im * rhs.im),
                               (lhs.re * rhs.im) + (lhs.im * rhs.re));
}

vk_complex64 jit_complex_scale(vk_complex64 value, double scale)
{
    return jit_make_complex(value.re * scale, value.im * scale);
}

vk_complex64 jit_complex_magnitude_squared(vk_complex64 value)
{
    return jit_make_complex(jit_complex_abs_sq(value), 0.0);
}

vk_complex64 jit_complex_exp(vk_complex64 value)
{
    double sin_im = 0.0;
    double cos_im = 0.0;
    double exp_re = exp_double(value.re);
    sincos_double(value.im, sin_im, cos_im);
    return jit_make_complex(exp_re * cos_im, exp_re * sin_im);
}

vk_complex64 jit_complex_log(vk_complex64 value)
{
    double radius = sqrt(jit_complex_abs_sq(value));
    double angle = atan2_double(value.im, value.re);
    return jit_make_complex(log_double(radius), angle);
}

vk_complex64 jit_complex_real_pow(vk_complex64 value, double exponent)
{
    double radius = sqrt(jit_complex_abs_sq(value));
    if (radius == 0.0) {
        if (exponent == 0.0) {
            return jit_make_complex(1.0, 0.0);
        }
        return jit_make_complex(0.0, 0.0);
    }

    double angle = atan2_double(value.im, value.re);
    double scaled_angle = exponent * angle;
    double scaled_radius = pow_double(radius, exponent);
    double sin_angle = 0.0;
    double cos_angle = 0.0;
    sincos_double(scaled_angle, sin_angle, cos_angle);
    return jit_make_complex(scaled_radius * cos_angle,
                               scaled_radius * sin_angle);
}

vk_complex64 jit_complex_pow(vk_complex64 base, vk_complex64 exponent)
{
    double radius = sqrt(jit_complex_abs_sq(base));
    if (radius == 0.0) {
        if (exponent.re == 0.0 && exponent.im == 0.0) {
            return jit_make_complex(1.0, 0.0);
        }
        return jit_make_complex(0.0, 0.0);
    }

    double theta = atan2_double(base.im, base.re);
    double log_radius = log_double(radius);
    double scaled_re = (exponent.re * log_radius) - (exponent.im * theta);
    double scaled_im = (exponent.re * theta) + (exponent.im * log_radius);
    double magnitude = exp_double(scaled_re);
    double sin_angle = 0.0;
    double cos_angle = 0.0;
    sincos_double(scaled_im, sin_angle, cos_angle);
    return jit_make_complex(magnitude * cos_angle,
                               magnitude * sin_angle);
}

vk_complex64 jit_complex_div(vk_complex64 lhs, vk_complex64 rhs)
{
    return jit_complex_mul(lhs, jit_complex_real_pow(rhs, -1.0));
}

vk_complex64 jit_complex_sin(vk_complex64 value)
{
    double sin_re = 0.0;
    double cos_re = 0.0;
    sincos_double(value.re, sin_re, cos_re);
    double exp_im = exp_double(value.im);
    double exp_neg_im = exp_double(-value.im);
    double cosh_im = 0.5 * (exp_im + exp_neg_im);
    double sinh_im = 0.5 * (exp_im - exp_neg_im);
    return jit_make_complex(sin_re * cosh_im,
                               cos_re * sinh_im);
}

vk_complex64 jit_complex_cos(vk_complex64 value)
{
    double sin_re = 0.0;
    double cos_re = 0.0;
    sincos_double(value.re, sin_re, cos_re);
    double exp_im = exp_double(value.im);
    double exp_neg_im = exp_double(-value.im);
    double cosh_im = 0.5 * (exp_im + exp_neg_im);
    double sinh_im = 0.5 * (exp_im - exp_neg_im);
    return jit_make_complex(cos_re * cosh_im,
                               -sin_re * sinh_im);
}

#endif
