#version 460
#extension GL_GOOGLE_include_directive : require
#include "nlo_precision.glslinc"

#include "complex_device.glslinc"

layout(local_size_x = 64) in;

layout(push_constant) uniform PushConstants {
    uint count;
    uint _pad;
    nlo_real scalar0;
    nlo_real scalar1;
} pc;

layout(set = 0, binding = 0, std430) buffer DstBuffer {
    vk_complex64 dst[];
};

const nlo_real TWO_PI = 6.283185307179586476925286766559;

void main()
{
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.count) {
        return;
    }
    if (!(pc.scalar0 > 0.0)) {
        dst[idx].re = 0.0;
        dst[idx].im = 0.0;
        return;
    }

    nlo_real step = TWO_PI / (nlo_real(pc.count) * pc.scalar0);
    uint positive_limit = (pc.count - 1u) / 2u;
    nlo_real value = 0.0;
    if (idx <= positive_limit) {
        value = nlo_real(idx) * step;
    } else {
        value = -(nlo_real(pc.count - idx) * step);
    }
    dst[idx].re = value;
    dst[idx].im = 0.0;
}
