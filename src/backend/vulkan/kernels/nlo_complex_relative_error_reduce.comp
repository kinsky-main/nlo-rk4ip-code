#version 460
#extension GL_GOOGLE_include_directive : require
#include "nlo_precision.glslinc"

#include "complex_device.glslinc"

layout(local_size_x = 64) in;

layout(push_constant) uniform PushConstants {
    uint count;
    uint _pad;
    nlo_real scalar0;
    nlo_real scalar1;
} pc;

layout(set = 0, binding = 0, std430) buffer DstBuffer {
    nlo_real partial_ratio[];
};

layout(set = 0, binding = 1, std430) readonly buffer CurrentBuffer {
    vk_complex64 current_vals[];
};

layout(set = 0, binding = 2, std430) readonly buffer PreviousBuffer {
    vk_complex64 previous_vals[];
};

shared nlo_real shared_max[64];

void main()
{
    uint global_idx = gl_GlobalInvocationID.x;
    uint local_idx = gl_LocalInvocationID.x;
    uint group_idx = gl_WorkGroupID.x;

    nlo_real ratio = 0.0;
    if (global_idx < pc.count) {
        nlo_real curr_re = current_vals[global_idx].re;
        nlo_real curr_im = current_vals[global_idx].im;
        nlo_real prev_re = previous_vals[global_idx].re;
        nlo_real prev_im = previous_vals[global_idx].im;

        nlo_real diff_re = curr_re - prev_re;
        nlo_real diff_im = curr_im - prev_im;
        nlo_real diff_sq = diff_re * diff_re + diff_im * diff_im;
        nlo_real prev_sq = prev_re * prev_re + prev_im * prev_im;
        nlo_real denom = max(prev_sq, pc.scalar0);
        ratio = diff_sq / denom;
    }

    shared_max[local_idx] = ratio;
    barrier();

    for (uint stride = 32u; stride > 0u; stride >>= 1u) {
        if (local_idx < stride) {
            shared_max[local_idx] = max(shared_max[local_idx], shared_max[local_idx + stride]);
        }
        barrier();
    }

    if (local_idx == 0u) {
        partial_ratio[group_idx] = shared_max[0u];
    }
}
