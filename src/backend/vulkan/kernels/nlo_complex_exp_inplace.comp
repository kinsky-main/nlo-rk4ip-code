#version 460
#extension GL_GOOGLE_include_directive : require
#include "nlo_precision.glslinc"

#include "complex_device.glslinc"
#include "double_math.glslinc"

layout(local_size_x = 64) in;

layout(push_constant) uniform PushConstants {
    uint count;
    uint _pad;
    nlo_real scalar0;
    nlo_real scalar1;
} pc;

layout(set = 0, binding = 0, std430) buffer DstBuffer {
    vk_complex64 dst[];
};

void main()
{
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.count) {
        return;
    }

    const nlo_real re = dst[idx].re;
    const nlo_real im = dst[idx].im;
    const nlo_real exp_re = exp_double(re);
    nlo_real sin_im = 0.0;
    nlo_real cos_im = 0.0;
    sincos_double(im, sin_im, cos_im);
    dst[idx].re = exp_re * cos_im;
    dst[idx].im = exp_re * sin_im;
}
